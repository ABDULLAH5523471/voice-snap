# Environment variables for VoiceSnap
# -------------------------------------------------
# AI transcription (GROQ)
GROQ_API_KEY=your_groq_api_key_here

# Rate limiting storage (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Owner bypass token (optional – gives unlimited usage)
OWNER_BYPASS_TOKEN=your_owner_bypass_token

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Paddle payment integration
PADDLE_API_KEY=your_paddle_api_key
PADDLE_VENDOR_ID=your_paddle_vendor_id
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
NEXT_PUBLIC_PADDLE_PRODUCT_ID=your_paddle_product_id
NEXT_PUBLIC_PADDLE_PRICE_ID=your_paddle_price_id
